# Copia este ficheiro para ".env" e mete os teus valores do Supabase.
# Encontras-os em: Supabase → Project Settings → API
#  - VITE_SUPABASE_URL      = "Project URL"
#  - VITE_SUPABASE_ANON_KEY = "anon public" key  (é segura para o navegador)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: anti-robô no login/registo (Cloudflare Turnstile "Site key").
# Só faz efeito com "Captcha protection" ligado no Supabase (ver supabase/seguranca.sql).
VITE_TURNSTILE_SITE_KEY=
